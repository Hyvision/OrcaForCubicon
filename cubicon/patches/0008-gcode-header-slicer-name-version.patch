 std::string header_slic3r_generated()
 {
-	return std::string(SLIC3R_APP_NAME " " SoftFever_VERSION);
+	// Cubicon: the G-code header identifies the slicer to Moonraker/Mainsail, which only parses
+	// metadata (object height, layer height, filament, print time, ...) when the "generated by"
+	// line starts with a slicer name it recognizes (OrcaSlicer/PrusaSlicer/BambuStudio/...).
+	// "OrcaForCubicon" is not recognized -> shows "Unknown" and no metadata. So emit the upstream
+	// official name (SLIC3R_OFFICIAL_NAME = "OrcaSlicer") followed by the OrcaForCubicon product
+	// version (CUBI_ORCA_VERSION, e.g. "1.5.0-rc1"), NOT the upstream SoftFever_VERSION ("2.4.2").
+	// GCodeProcessor still recognizes this via its literal "generated by OrcaSlicer" producer tag.
+	return std::string(SLIC3R_OFFICIAL_NAME " " CUBI_ORCA_VERSION);
 }
 
